GATEWAY_APP_NAME=Neurovians AI Gateway
GATEWAY_ENVIRONMENT=development
GATEWAY_LOG_LEVEL=INFO

# Leave empty to keep traces local. Set an OTLP/HTTP collector endpoint later.
GATEWAY_OTEL_ENDPOINT=

# The queue implementation is intentionally not chosen yet.
GATEWAY_QUEUE_BACKEND=unconfigured
GATEWAY_EVALUATION_REQUESTED_TOPIC=evaluation.requested
GATEWAY_PROMPT_READY_TOPIC=evaluation.prompt-ready
GATEWAY_MODEL_CALL_REQUESTED_TOPIC=evaluation.model-call-requested
GATEWAY_RESPONSE_COMPLETED_TOPIC=evaluation.response-completed
GATEWAY_EVALUATION_COMPLETED_TOPIC=evaluation.completed
